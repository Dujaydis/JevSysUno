# Required. Obtain from TypeSafe's console (early access is waitlisted).
TYPESAFE_API_KEY=

# Pin a concrete version in production. `jev-latest` is an ALIAS and moves when a new
# version ships -- which silently invalidates the calibration you measured.
# Discover concrete names with: GET /v1/models
TYPESAFE_DEFAULT_MODEL=jev-latest

# UNVERIFIED. The widely-quoted $0.042 / 1M input tokens figure could not be confirmed
# from any first-party TypeSafe source. Leave unset and cost estimation reports
# "unknown" rather than a confident wrong number. Set it only once you have read the
# real figure off typesafe.ai/pricing yourself.
JEV_PRICE_PER_M_INPUT_USD=
